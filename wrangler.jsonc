{
  // The Mord Hive app itself. The Worker "mordhivemanager" builds from root
  // directory "/" with "npm run build"; production deploys run
  // "npx wrangler deploy", branch builds "npx wrangler preview".
  // Declared explicitly because wrangler's auto-config refuses Vite 5.
  "name": "mordhivemanager",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Branch/PR builds run `npx wrangler preview`, which refuses to run without
  // this block (empty is enough).
  "previews": {}
}
